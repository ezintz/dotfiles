#!/usr/bin/env zsh

## Ensure colors are available.
autoload -U colors && colors

## Path where the dotfiles will be placed.
DOTFILES_DIRECTORY="${HOME}/.dotfiles"

## Git remote repository
DOTFILES_GIT_REMOTE="https://github.com/ezintz/dotfiles.git"

## Optional private overlay directory (can be a separate private git repo).
DOTFILES_LOCAL_DIRECTORY="${HOME}/.dotfiles-private"

## Homebrew formulae
DESIRED_HOMEBREW_FORMULAE=(
  'ack'
  'bat'
  'coreutils'
  'curl'
  'duti'
  'fortune'
  'jq'
  'git'
  'git-extras'
  'git-flow'
  'helm'
  'kubernetes-cli'
  'node'
  'reattach-to-user-namespace'
  'tmux'
  'wireguard-tools'
  'wget'
)

DESIRED_HOMEBREW_CASK_FORMULAE=(
  '1password'
  'docker'
  'dropbox'
  'google-chrome'
  'google-drive'
  'krisp'
  'microsoft-edge'
  'orbstack'
  'sequel-ace'
  'slack'
  'stats'
  'visual-studio-code'
  'jetbrains-toolbox'
  'font-jetbrains-mono-nerd-font'
)

## NPM packages
DESIRED_NPM_PACKAGES=(
  '@angular/cli'
  'npm-check'
)


if [[ ! -d ${DOTFILES_DIRECTORY} ]]; then
  git clone --recursive ${DOTFILES_GIT_REMOTE} ${DOTFILES_DIRECTORY}
fi

## Change directory to our dotfiles.
cd ${DOTFILES_DIRECTORY}

## Load helpers
source ${DOTFILES_DIRECTORY}/bin/_helpers

## Create symbolic links in home directory.
## $1 - Source file
## $2 - Target file
function link {
  if [[ -L "${HOME}/${2}" ]]; then
    return
  fi

  if [[ -f "${HOME}/${2}" ]]; then
    echo "File '${HOME}/${2}' exists, creating a backup as '${HOME}/${2}_backup'"
    cp "${HOME}/${2}" "${HOME}/${2}_backup"
fi

  ln -fs "${DOTFILES_DIRECTORY}/${1}" "${HOME}/${2}"
}

## Merge tracked JSON settings into an existing file using jq, adding or
## replacing only the keys defined in the source while preserving any other
## keys already present in the destination (e.g. machine-specific permissions,
## model, plugins). Falls back to a plain copy when the destination is absent.
## $1 - Source file (relative to DOTFILES_DIRECTORY)
## $2 - Target file (relative to HOME)
function merge_json {
  local src="${DOTFILES_DIRECTORY}/${1}"
  local dest="${HOME}/${2}"

  if ! command -v jq >/dev/null 2>&1; then
    echo "jq not found; skipping JSON merge for '${2}' (install jq to manage it)"
    return
  fi

  mkdir -p "$(dirname "${dest}")"

  ## No existing settings — just seed with the tracked defaults.
  if [[ ! -e "${dest}" ]]; then
    cp "${src}" "${dest}"
    return
  fi

  ## Deep-merge tracked keys into the existing file (tracked values win),
  ## reading through the destination even if it is a symlink from an older setup.
  local tmp
  tmp="$(mktemp)"
  if jq -s '.[0] * .[1]' "${dest}" "${src}" >| "${tmp}" 2>/dev/null; then
    rm -f "${dest}"   ## drop any pre-existing symlink so we write a real file
    mv "${tmp}" "${dest}"
  else
    echo "Failed to merge JSON for '${2}'; leaving existing file untouched"
    rm -f "${tmp}"
  fi
}

function mirror_local_files {
  [[ -d "${DOTFILES_LOCAL_DIRECTORY}" ]] || return

  local known_links=(
    "gitconfig.local:.gitconfig.local"
    "zpreztorc.local:.zpreztorc.local"
    "tmux.conf.local:.tmux.conf.local"
    "zprofile.local:.zprofile.local"
  )

  for entry in $known_links; do
    local src="${entry%%:*}"
    local dest="${entry##*:}"
    if [[ -f "${DOTFILES_LOCAL_DIRECTORY}/${src}" ]]; then
      ln -fs "${DOTFILES_LOCAL_DIRECTORY}/${src}" "${HOME}/${dest}"
    fi
  done
}

## Link Claude Code skills into ~/.claude/skills, which Claude scans one level
## deep for <name>/SKILL.md. Skills come from three tiers:
##   1. tracked   ${DOTFILES_DIRECTORY}/claude/skills   -> public, pushed to GitHub
##   2. private   ${DOTFILES_LOCAL_DIRECTORY}/claude/skills -> private overlay repo
##   3. local     plain directories in ~/.claude/skills  -> this machine only
## Only tiers 1 and 2 are linked; a real directory always wins over a link so a
## machine-local skill is never clobbered by a tracked one of the same name.
function mirror_skills {
  local skills_dir="${HOME}/.claude/skills"
  mkdir -p "${skills_dir}"

  ## Prune dangling links left behind by skills renamed or removed upstream.
  local existing
  for existing in "${skills_dir}"/*(@N); do
    [[ -e "${existing}" ]] || rm -f "${existing}"
  done

  local source_dir skill name
  for source_dir in \
    "${DOTFILES_DIRECTORY}/claude/skills" \
    "${DOTFILES_LOCAL_DIRECTORY}/claude/skills"
  do
    [[ -d "${source_dir}" ]] || continue

    for skill in "${source_dir}"/*(/N); do
      name="${skill:t}"

      if [[ -d "${skills_dir}/${name}" && ! -L "${skills_dir}/${name}" ]]; then
        print_warning "Skill '${name}' exists as a local directory; not linking ${skill}"
        continue
      fi

      ln -fsn "${skill}" "${skills_dir}/${name}"
    done
  done
}

function mirror_files {
  ## ensure ssh control path directory exists
  mkdir -p ~/.ssh/control/

  link "curlrc" ".curlrc"
  link "wgetrc" ".wgetrc"

  link "ssh/config" ".ssh/config"
  link "ssh/config.d" ".ssh"

  link "git/gitignore" ".gitignore"
  link "git/gitattributes" ".gitattributes"
  link "git/gitconfig" ".gitconfig"

  link "prezto/runcoms/zlogin" ".zlogin"
  link "prezto/runcoms/zlogout" ".zlogout"
  link "prezto/runcoms/zprofile" ".zprofile"
  link "prezto/runcoms/zpreztorc" ".zpreztorc"
  link "prezto/runcoms/zshenv" ".zshenv"

  link "tmux/tmux.conf" ".tmux.conf"
  mkdir -p "${HOME}/.tmux"
  link "tmux/plugins" ".tmux/plugins"

  mkdir -p "${HOME}/.claude/hooks"
  ## Named differently from the symlink target so Claude Code's in-repo
  ## CLAUDE.md auto-discovery doesn't also load it a second time as a
  ## project file when working inside this repo.
  link "claude/global-instructions.md" ".claude/CLAUDE.md"
  link "claude/statusline-command.sh" ".claude/statusline-command.sh"
  ## Every guard sources guard-lib.sh, so it must be linked too or all four break.
  link "claude/hooks/guard-lib.sh" ".claude/hooks/guard-lib.sh"
  link "claude/hooks/kubectl-env-guard.sh" ".claude/hooks/kubectl-env-guard.sh"
  link "claude/hooks/terraform-env-guard.sh" ".claude/hooks/terraform-env-guard.sh"
  link "claude/hooks/openstack-env-guard.sh" ".claude/hooks/openstack-env-guard.sh"
  link "claude/hooks/argocd-env-guard.sh" ".claude/hooks/argocd-env-guard.sh"
  merge_json "claude/settings.json" ".claude/settings.json"
  ## User-scope MCP servers live in ~/.claude.json (top-level mcpServers).
  ## Deep-merge the tracked set in, preserving Claude's own state in that file.
  ## Secrets are referenced as ${VAR} and exported from ~/.zprofile.local.
  merge_json "claude/mcp.json" ".claude.json"
  mirror_skills

  ## Do not create a link for the `.zshrc` since it might contain local configuration.
  if [[ ! -e $HOME/.zshrc ]]; then
    link "prezto/runcoms/zshrc" ".zshrc"
  fi
}

## Test for known flags.
for opt in $@
do
  case $opt in
    -nc|--no-configuration) no_configuration=true ;;
    -np|--no-packages) no_packages=true ;;
    -ns|--no-sync) no_sync=true ;;
    -nl|--no-links) no_links=true ;;
    -*|--*) print_warning "Invalid option $opt" ;;
  esac
done

## If the host is running MacOS.
if is_macos; then
  ## Before relying on Homebrew, check that packages can be compiled.
  if ! type_exists 'gcc'; then
    abort "The XCode Command Line Tools must be installed first. Download them from https://developer.apple.com/downloads" 1
  fi

  ## Check for Homebrew
  if ! type_exists 'brew'; then
    print_header "Installing Homebrew ..."
    seek_confirmation "Do you want to install homebrew now?"
    if is_confirmed; then
      print_notice "Downloading Homebrew ..."
      /usr/bin/ruby -e "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)"
    fi
    abort "Homebrew must be installed. For more information visit the website: http://mxcl.github.io/homebrew" 1
  fi
fi

## Source local package additions if private overlay exists.
if [[ -f "${DOTFILES_LOCAL_DIRECTORY}/packages.zsh" ]]; then
  source "${DOTFILES_LOCAL_DIRECTORY}/packages.zsh"
fi

## Install or update packages.
if [ $no_packages ]; then
  print_notice "Skipped installation of additional packages."
else
  ## Installing Homebrew formulae only on hosts that are running MacOS.
  if is_macos; then;
    install_brew_formulae
    install_brew_cask_formulae
  fi

  ## Install node.js packages.
  install_npm_packages

  ## Install tmux plugins managed by TPM.
  #install_tmux_plugins
fi

## Conditionally sync with the remote repository.
if [ $no_sync ]; then
  print_notice "Skipped dotfiles synchronization."
else
  print_notice "Syncing dotfiles ..."
  ## Pull down the latest changes.
  git pull --rebase origin main
  ## Sync submodules.
  git submodule sync --recursive
  ## Pull private overlay if it exists as a git repo.
  if [[ -d "${DOTFILES_LOCAL_DIRECTORY}/.git" ]]; then
    print_notice "Syncing private dotfiles overlay ..."
    git -C "${DOTFILES_LOCAL_DIRECTORY}" pull --rebase
  fi
  print_success "... done!"
fi

if [ $no_configuration ]; then
  print_notice "Skipped dotfiles setup."
else
  print_header "Setting up dotfiles"
  seek_confirmation "This step may overwrite existing dotfiles."
  if is_confirmed; then
    print_notice "Mirroring dotfiles ..."
    mirror_files
    mirror_local_files
    print_success "... done!"
  else
    print_notice "Skipped mirroring dotfiles."
  fi

  if is_macos; then
    print_header "OS X settings update"
    seek_confirmation "Warning: This step may overwrite your OS X settings."
    if is_confirmed; then
      print_notice "Updating settings ..."
      source bin/_macos
      print_success "... done!"
      print_notice "Note that some of these changes require a logout/restart to take effect."
    else
      print_notice "Skipped OS X settings update."
    fi
  fi

  setup_git
fi
