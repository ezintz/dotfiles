#!/bin/sh
#
# Sync this repository, install packages, link the config into $HOME and apply
# the macOS defaults. Safe to re-run.
#
# POSIX sh on purpose: it is the one shell present on a fresh Mac *and* on a
# Debian or Alpine server, where zsh (which this used to be written in) is not.
# A machine without the checkout yet starts from install.sh instead.

usage() {
  cat <<'EOF'
Usage: dotfiles [options]

  -np, --no-packages       do not install or update packages
  -ns, --no-sync           do not pull this repository or its submodules
  -nl, --no-links          do not create symlinks or ask for the Git identity
  -nc, --no-configuration  do not apply the macOS defaults (bin/_macos)
  -no, --no-overlay        do not set up or back up the private overlay repository
  -y,  --yes               answer yes to every question except "restart now?"
       --dry-run           print what would change, change nothing
  -h,  --help              show this help
EOF
}

## Everything runs from inside main, which the shell has to parse completely
## before running any of it. That matters because the sync step can rewrite this
## very file, and sh otherwise reads a script as it executes it.
main() {
  DOTFILES_DIRECTORY=$(cd "$(dirname "$0")/.." && pwd -P)
  ## The private overlay (see Readme): configuration, so it lives where XDG
  ## puts user configuration.
  DOTFILES_LOCAL_DIRECTORY="${XDG_CONFIG_HOME:-${HOME}/.config}/dotfiles"
  export DOTFILES_DIRECTORY DOTFILES_LOCAL_DIRECTORY

  . "${DOTFILES_DIRECTORY}/bin/lib/ui.sh"
  . "${DOTFILES_DIRECTORY}/bin/lib/links.sh"
  . "${DOTFILES_DIRECTORY}/bin/lib/claude.sh"
  . "${DOTFILES_DIRECTORY}/bin/lib/packages.sh"
  . "${DOTFILES_DIRECTORY}/bin/lib/overlay.sh"

  no_packages=; no_sync=; no_links=; no_configuration=; no_overlay=
  for opt in "$@"; do
    case "$opt" in
      -np|--no-packages) no_packages=1 ;;
      -ns|--no-sync) no_sync=1 ;;
      -nl|--no-links) no_links=1 ;;
      -nc|--no-configuration) no_configuration=1 ;;
      -no|--no-overlay) no_overlay=1 ;;
      -y|--yes) DOTFILES_YES=1 ;;
      --dry-run) DOTFILES_DRY_RUN=1 ;;
      -h|--help) usage; exit 0 ;;
      *) print_warning "Invalid option $opt"; usage; exit 2 ;;
    esac
  done
  export DOTFILES_YES="${DOTFILES_YES:-}" DOTFILES_DRY_RUN="${DOTFILES_DRY_RUN:-}"
  [ -n "$DOTFILES_DRY_RUN" ] && print_notice "Dry run: nothing will be changed."

  ## prezto's runcoms, tmux.conf and the Claude session hooks all name
  ## ~/.dotfiles, so a checkout anywhere else links config that points nowhere.
  if [ "$DOTFILES_DIRECTORY" != "$(cd "${HOME}/.dotfiles" 2>/dev/null && pwd -P)" ]; then
    print_warning "This checkout is not at ~/.dotfiles, which the shell and tmux config expect."
  fi

  ## Before sync, which pulls the overlay from its new location.
  migrate_overlay

  if is_macos && ! xcode-select -p >/dev/null 2>&1; then
    abort "The Xcode Command Line Tools are missing. Run install.sh, or 'xcode-select --install' and re-run."
  fi

  if [ -n "$no_sync" ]; then
    print_notice "Skipped dotfiles synchronization."
  else
    sync_repositories "$@"
  fi

  if [ -n "$no_packages" ]; then
    print_notice "Skipped installation of packages."
  else
    install_packages
  fi

  ## After the tracked packages, which bring the forge CLIs (gh, glab, tea) a
  ## new machine needs to create or restore the overlay; before everything that
  ## reads the overlay.
  [ -n "$no_overlay" ] || setup_overlay
  [ -n "$no_packages" ] || install_overlay_packages

  if [ -n "$no_links" ]; then
    print_notice "Skipped mirroring dotfiles."
  else
    print_header "Setting up dotfiles"
    if confirm "Link the dotfiles into ${HOME}? Existing files are moved aside, not deleted."; then
      mirror_files
      setup_claude
      print_success "... done!"
    else
      print_notice "Skipped mirroring dotfiles."
    fi
    ## gitauthor is the identity the linked gitconfig includes, so it belongs
    ## with the links rather than with the macOS defaults.
    setup_git
  fi

  if [ -n "$no_configuration" ]; then
    print_notice "Skipped macOS settings update."
  elif is_macos; then
    print_header "macOS settings update"
    if confirm "Apply the macOS defaults in bin/_macos? This overwrites the matching system settings."; then
      run sh "${DOTFILES_DIRECTORY}/bin/_macos"
      print_success "... done!"
    else
      print_notice "Skipped macOS settings update."
    fi
  fi

  [ -n "$no_overlay" ] || backup_overlay
}

# prezto and the Claude Code plugin are repositories of their own that get
# committed to from inside this checkout. A plain `submodule update` would
# detach them from their branch, stranding the next commit made there, so one
# that is on a branch is fast-forwarded instead; its branch is where every
# recorded commit came from, so that never lands behind the recorded one.
sync_own_submodule() {
  _sub="${DOTFILES_DIRECTORY}/$1"
  if [ ! -e "${_sub}/.git" ]; then
    run git -C "$DOTFILES_DIRECTORY" submodule update --init --recursive "$1"
  elif git -C "$_sub" symbolic-ref -q HEAD >/dev/null; then
    run git -C "$_sub" pull --ff-only -q ||
      print_warning "Could not fast-forward $1; it has local commits or changes"
  else
    run git -C "$DOTFILES_DIRECTORY" submodule update --recursive "$1"
  fi
}

sync_repositories() {
  if [ ! -d "${DOTFILES_DIRECTORY}/.git" ]; then
    print_notice "Not a git checkout (installed from a tarball); skipped synchronization."
    return 0
  fi
  print_notice "Syncing dotfiles ..."
  _before=$(git -C "$DOTFILES_DIRECTORY" rev-parse HEAD)
  run git -C "$DOTFILES_DIRECTORY" pull --rebase --autostash ||
    print_warning "git pull failed; continuing with the current checkout"
  run git -C "$DOTFILES_DIRECTORY" submodule sync --recursive
  sync_own_submodule prezto
  sync_own_submodule claude/plugin
  run git -C "$DOTFILES_DIRECTORY" submodule update --init tmux/plugins/tmux-resurrect
  if [ -d "${DOTFILES_LOCAL_DIRECTORY}/.git" ]; then
    print_notice "Syncing private dotfiles overlay ..."
    run git -C "$DOTFILES_LOCAL_DIRECTORY" pull --rebase ||
      print_warning "git pull failed for ${DOTFILES_LOCAL_DIRECTORY}"
  fi
  print_success "... done!"

  ## A pull that changed this script or its libraries must not run the rest of
  ## the old version: start over on the new one, without syncing again.
  if [ "$_before" != "$(git -C "$DOTFILES_DIRECTORY" rev-parse HEAD)" ]; then
    print_notice "Updated; restarting with the new version ..."
    exec sh "${DOTFILES_DIRECTORY}/bin/dotfiles" --no-sync "$@"
  fi
}

setup_git() {
  has git || return 0
  _gitauthor="${DOTFILES_LOCAL_DIRECTORY}/gitauthor"
  [ -n "$(git config --file "$_gitauthor" user.name 2>/dev/null)" ] && return 0
  [ -n "${DOTFILES_DRY_RUN:-}" ] && { print_notice "Would ask for the Git identity (${_gitauthor})."; return 0; }

  print_header "Setting up Git identity ..."
  ## A subshell, not { …; }: in dash and busybox a failed redirection on the
  ## special builtin `:` exits the whole script, and there is no terminal in a
  ## container or under `curl | sh` without one.
  if ! (: < /dev/tty) 2>/dev/null; then
    print_warning "No terminal to ask on. Set it later: git config --file ${_gitauthor} user.name 'Your Name' (and user.email)"
    return 0
  fi
  _username=; _email=
  while [ -z "$(printf '%s' "$_username" | tr -d '[:space:]')" ]; do
    printf 'Your name (e.g. Walter White): '; read -r _username < /dev/tty || return 0
  done
  while [ -z "$(printf '%s' "$_email" | tr -d '[:space:]')" ]; do
    printf 'Your e-mail address: '; read -r _email < /dev/tty || return 0
  done
  if ask "Configure Git with \"${_username}\" <${_email}>?"; then
    mkdir -p "$DOTFILES_LOCAL_DIRECTORY"
    git config --file "$_gitauthor" user.name "$_username"
    git config --file "$_gitauthor" user.email "$_email"
    print_success "... done!"
  else
    print_warning "Git identity not set. See https://git-scm.com/book/en/v2/Getting-Started-First-Time-Git-Setup"
  fi
}

main "$@"
