##
## Spotlight
##

## Hide Spotlight tray-icon (and subsequent helper)
# sudo chmod 600 /System/Library/CoreServices/Search.bundle/Contents/MacOS/Search

## Reindexing is the most expensive thing in this file — hours of CPU and a
## Spotlight that answers nothing meanwhile — so it happens only when one of
## the settings below actually moved. It has to stay inside this window rather
## than run on its own: excluding a directory is what drops the content that
## is already in the index, so the exclusion and the rebuild go together.
_spotlight_changes=$MACOS_CHANGES

## Disable Spotlight indexing for any volume that gets mounted and has not yet
## been indexed before.
## Use `sudo mdutil -i off "/Volumes/foo"` to stop indexing any volume.
sudo_set_default_merged /.Spotlight-V100/VolumeConfiguration Exclusions -array "/Volumes"

## Change indexing order and disable some search results
set_default_merged com.apple.spotlight orderedItems -array \
	'{"enabled" = 1;"name" = "APPLICATIONS";}' \
	'{"enabled" = 1;"name" = "SYSTEM_PREFS";}' \
	'{"enabled" = 1;"name" = "DIRECTORIES";}' \
	'{"enabled" = 1;"name" = "PDF";}' \
	'{"enabled" = 1;"name" = "PRESENTATIONS";}' \
	'{"enabled" = 1;"name" = "DOCUMENTS";}' \
	'{"enabled" = 1;"name" = "SPREADSHEETS";}' \
	'{"enabled" = 0;"name" = "FONTS";}' \
	'{"enabled" = 0;"name" = "MESSAGES";}' \
	'{"enabled" = 0;"name" = "CONTACT";}' \
	'{"enabled" = 0;"name" = "EVENT_TODO";}' \
	'{"enabled" = 0;"name" = "IMAGES";}' \
	'{"enabled" = 0;"name" = "BOOKMARKS";}' \
	'{"enabled" = 0;"name" = "MUSIC";}' \
	'{"enabled" = 0;"name" = "MOVIES";}' \
	'{"enabled" = 0;"name" = "SOURCE";}' \
	'{"enabled" = 0;"name" = "MENU_DEFINITION";}' \
	'{"enabled" = 0;"name" = "MENU_OTHER";}' \
	'{"enabled" = 0;"name" = "MENU_CONVERSION";}' \
	'{"enabled" = 0;"name" = "MENU_EXPRESSION";}' \
	'{"enabled" = 0;"name" = "MENU_WEBSEARCH";}' \
	'{"enabled" = 0;"name" = "MENU_SPOTLIGHT_SUGGESTIONS";}'

## Keep Spotlight out of the workspace directory.
##
## Not with mdutil: it takes mount points, and ~/Workspace is a directory on
## the data volume, so `mdutil -i off ~/Workspace` fails with "unknown
## indexing state" — which is what it had been doing silently. The supported
## per-directory exclusion is the marker file, and deleting the file undoes it.
if [ -d "$HOME/Workspace" ] && [ ! -e "$HOME/Workspace/.metadata_never_index" ]; then
  touch "$HOME/Workspace/.metadata_never_index" &&
    macos_changed "Spotlight excluded from ~/Workspace"
fi

## Make sure indexing is enabled for the main volume
case $(mdutil -s / 2>/dev/null) in
  *"Indexing enabled"*) ;;
  *) sudo mdutil -i on / > /dev/null && macos_changed "Spotlight indexing enabled on /" ;;
esac

if [ "$MACOS_CHANGES" -ne "$_spotlight_changes" ]; then
  ## Load new settings before rebuilding the index
  killall mds > /dev/null 2>&1

  ## Rebuild the index from scratch
  sudo mdutil -E / > /dev/null
fi

