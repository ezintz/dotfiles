## Reset Launchpad, but keep the desktop wallpaper intact.
##
## The one thing in this file that cannot be made conditional: the database
## holds the arrangement rather than a setting, so there is no "already in
## place" to compare against and deleting it throws away however the icons
## have been ordered since. It is asked with `ask` and not `confirm` for that
## reason — `--yes` answers the routine questions, and wiping the Launchpad
## layout on every unattended run is not one of them.
if [ -n "$(find "${HOME}/Library/Application Support/Dock" -maxdepth 1 -name '*-*.db' 2>/dev/null)" ] &&
  ask "Reset the Launchpad layout?"; then
  find "${HOME}/Library/Application Support/Dock" -maxdepth 1 -name "*-*.db" -delete &&
    macos_changed "Launchpad layout reset"
fi

## Add iOS & Watch Simulator to Launchpad
## Without Xcode these would be dangling links in /Applications, and recent
## Xcode versions ship no Watch simulator app at all.
if [ -d /Applications/Xcode.app ]; then
  for _sim in "Simulator" "Simulator (Watch)"; do
    _sim_app="/Applications/Xcode.app/Contents/Developer/Applications/${_sim}.app"
    _sim_link="/Applications/${_sim}.app"
    [ -d "$_sim_app" ] || continue
    [ "$(readlink "$_sim_link" 2>/dev/null)" = "$_sim_app" ] && continue
    sudo ln -sf "$_sim_app" "$_sim_link" && macos_changed "linked ${_sim_link}"
  done
fi

