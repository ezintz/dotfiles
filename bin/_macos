##
## AltTab (window switcher; replaces HyperSwitch, which is unmaintained and
## no longer in Homebrew). Its defaults already match what HyperSwitch was set
## to: ⌥⇥ cycles all windows, ⇧ goes back, ⌥` cycles the current app's windows.
## AltTab stores every preference as a string.
##

set_default com.lwouis.alt-tab-macos windowDisplayDelay -string 1000
## AppearanceSizePreference: 0 small, 1 medium, 2 large, 3 auto.
set_default com.lwouis.alt-tab-macos appearanceSize -string 1
set_default com.lwouis.alt-tab-macos startAtLogin -string true

##
## Stats (menu bar system monitor). Unlike iTerm2 it cannot read its
## preferences from a folder, and a symlinked plist is rewritten by cfprefsd,
## so the settings worth sharing are written as defaults here. Left out on
## purpose: `NSStatusItem Preferred Position *` (menu bar x-coordinates, which
## depend on the display and on what else sits up there), the settings window
## frame, `remote_id`, and the updater/support timestamps — all per-machine.
## Stats reads its preferences only at launch, so it is relaunched below.
##

_stats_changes=$MACOS_CHANGES

## Modules shown in the menu bar.
set_default eu.exelban.Stats CPU_state -bool true
set_default eu.exelban.Stats RAM_state -bool true
set_default eu.exelban.Stats Network_state -bool true
set_default eu.exelban.Stats Disk_state -bool false
set_default eu.exelban.Stats Battery_state -bool false
set_default eu.exelban.Stats Sensors_state -bool false

## CPU: a bar per core, green, no box around it.
set_default eu.exelban.Stats CPU_widget -string "bar_chart"
set_default eu.exelban.Stats CPU_usagePerCore -bool true
set_default eu.exelban.Stats CPU_splitValue -bool false
set_default eu.exelban.Stats CPU_bar_chart_color -string "secondGreen"
set_default eu.exelban.Stats CPU_bar_chart_box -bool false
set_default eu.exelban.Stats CPU_processes -int 10

## RAM: same widget in blue.
set_default eu.exelban.Stats RAM_widget -string "bar_chart"
set_default eu.exelban.Stats RAM_bar_chart_color -string "secondBlue"
set_default eu.exelban.Stats RAM_bar_chart_box -bool false

## Network: up/down chart, purple down and yellow up.
set_default eu.exelban.Stats Network_widget -string "network_chart"
set_default eu.exelban.Stats Network_network_chart_downloadColor -string "secondPurple"
set_default eu.exelban.Stats Network_network_chart_uploadColor -string "secondYellow"

set_default eu.exelban.Stats LaunchAtLoginNext -bool true
set_default eu.exelban.Stats telemetry -bool false
set_default eu.exelban.Stats pause -bool false

## Only when something above moved, and only when Stats is already running:
## killing it otherwise would start an app the user had deliberately quit.
if [ "$MACOS_CHANGES" -ne "$_stats_changes" ] && pgrep -xq Stats; then
  killall Stats > /dev/null 2>&1
  open -a Stats
fi

##
## Set default applications
##

## Assign visual studio code as default to some file types.
set_default_app com.microsoft.VSCode public.plain-text
set_default_app com.microsoft.VSCode public.unix-executable
set_default_app com.microsoft.VSCode public.data

##
## Kill affected applications
##

## Nothing moved, so nothing needs restarting and there is nothing to ask
## about. This is the payoff for every check above: a second run leaves the
## desktop alone instead of blanking the Dock and the menu bar.
if [ "$MACOS_CHANGES" -eq 0 ]; then
  print_success "macOS settings already in place."
  exit 0
fi

print_success "${MACOS_CHANGES} macOS setting(s) changed."

## These re-read their preferences only on restart and hold no user work.
for app in "cfprefsd" "Dock" "Finder" "SystemUIServer"; do
  killall "${app}" > /dev/null 2>&1
done

## These can hold unsaved work (a draft mail, an unsaved editor buffer), so
## they only quit when asked; the new defaults apply on their next launch.
if confirm "Quit running apps whose settings changed (Mail, Safari, Chrome, Edge, VS Code, …)?"; then
  for app in "Activity Monitor" \
    "Address Book" \
    "Calendar" \
    "Contacts" \
    "Docker" \
    "Google Chrome Canary" \
    "Google Chrome" \
    "HyperDock" \
    "AltTab" \
    "Mail" \
    "Messages" \
    "Microsoft Edge" \
    "Photos" \
    "Safari" \
    "Sequel Ace" \
    "Skype" \
    "WebStorm" \
    "Visual Studio Code" \
    "iCal"; do
    killall "${app}" > /dev/null 2>&1
  done
fi

## Only the settings read by WindowServer or loginwindow survive the restarts
## above, and logout_if_changed has collected exactly the ones that moved. An
## empty list is an answer, not a missing warning: everything that changed has
## already taken effect.
if [ -z "$MACOS_LOGOUT_FOR" ]; then
  print_notice "No logout needed — the apps that read these settings were restarted."
  exit 0
fi

print_notice "Log out to apply: ${MACOS_LOGOUT_FOR}."
## ask, not confirm: --yes answers every other prompt, but never this one.
if ask "Restart now?"; then
	sudo reboot
fi
