#!/bin/bash
#Generated by JetBrains Toolbox 3.6.4.86641 at 2026-08-08T08:30:31

declare -a intellij_args=()
declare -- wait=""

for o in "$@"; do
  if [[ "$o" = "--wait" || "$o" = "-w" ]]; then
    wait="-W"
    o="--wait"
  fi
  if [[ "$o" =~ " " ]]; then
    intellij_args+=("\"$o\"")
  else
    intellij_args+=("$o")
  fi
done

open -na "/Users/eduard.zintz/Applications/PhpStorm.app/Contents/MacOS/phpstorm" $wait --args "${intellij_args[@]}"