# Font. JetBrains Mono (the Nerd Font build, for its icons) lacks the symbols
# in Claude Code's status line (▰ ▱ ◼ ⬆ …), so Ghostty borrows them, and the
# font it borrows from depends on what it drew first: a fallback loaded for one
# character is tried before any new search for the next. ⬆ comes before the
# bars in that status line and loads AppleGothic, which also has ▱ and ◼ --
# a full em wide, then enlarged to match JetBrains Mono's ideograph width --
# so the bars spill over their neighbours. Ghostty's own tool shows it:
#   ghostty +show-face --string='▱⬆'  ->  ▱ Menlo
#   ghostty +show-face --string='⬆▱'  ->  ▱ AppleGothic
# The font grid is shared by every tab, so one tab's status line decides for
# all of them, and a restart can come up either way. Fonts listed here are
# tried before any borrowed one and never resized: Menlo (iTerm2's choice) has
# every status-line symbol but the arrows at exactly one cell, and Apple
# Symbols then takes ⬆ ⬇ before AppleGothic can load.
font-family = "JetBrainsMono Nerd Font"
font-family = Menlo
font-family = "Apple Symbols"
font-size = 13

# Transparency. cmux applies background-opacity to its tab bar but not to the
# terminal panes unless a custom-shader is set -- any shader, hence this no-op
# passthrough (cmux issue #879, closed but still reproducing in 0.64.25).
# It has nothing to do with how symbols are drawn: removing it left the status
# line just as broken, and the font lines above are what fixed that.
background-opacity = 0.65
background-blur-radius = 20
# Without this a cell with an explicit background stays opaque, so every panel
# a TUI fills is a solid block on the translucent window -- Claude Code's
# changes pane most visibly, since its composerSidebarBackground cannot be
# unset: the theme format has no "default background" value. Even so a fill
# stays darker than the window, since it is drawn at this opacity on top of
# the window background drawn at it too: 0.65 leaves such a fill ~88% opaque.
background-opacity-cells = true
custom-shader = ~/.config/ghostty/passthrough.glsl

# OneDark colors (ported from ~/.dotfiles/iterm2/OneDark.itermcolors).
#
# Two slots deliberately differ from that import, in the iTerm2 copies too:
#   8  was #767676, a neutral grey that is not a OneDark colour at all. It is
#      the dim-text slot, so #5C6370 (OneDark's own comment grey) is correct --
#      and keeping it dark matters because TUIs paint slot 8 as a *background*
#      for panels, where a light grey leaves their foreground text unreadable.
#   15 was #ABB2BF, identical to slot 7, so bright white was not brighter than
#      white and emphasis flattened everywhere. #DCDFE4 restores the contrast.
background = #21252B
foreground = #ABB2BF
cursor-color = #ABB2BF
cursor-text = #21252B
selection-background = #323844
selection-foreground = #ABB2BF

palette = 0=#21252B
palette = 1=#E06C75
palette = 2=#98C379
palette = 3=#E5C07B
palette = 4=#61AFEF
palette = 5=#C678DD
palette = 6=#56B6C2
palette = 7=#ABB2BF
palette = 8=#5C6370
palette = 9=#E06C75
palette = 10=#98C379
palette = 11=#E5C07B
palette = 12=#61AFEF
palette = 13=#C678DD
palette = 14=#56B6C2
palette = 15=#DCDFE4

# Cursor: blinking underscore.
cursor-style = underline
# Also makes Ghostty ignore DEC mode 12 (the `ESC[?12l` "blink off" that curses
# apps emit via the cnorm capability), which is what keeps the blink alive after
# a full-screen program exits. DECSCUSR from the running program is still honoured.
cursor-style-blink = true

# Ghostty's zsh integration re-emits DECSCUSR on every prompt redraw and keymap
# change — a blinking bar, or a block in vi command mode — and resets to the
# default before each external command, so it overrides cursor-style on every
# keystroke. Turning that one feature off leaves path and title reporting intact.
shell-integration-features = no-cursor

# Cmd+K. Ghostty's own clear_screen does nothing while the pane is on the
# alternate screen, and every cmux tab runs tmux (tmux/cmux.zsh), which lives
# there -- so the key did nothing at all. Send a key tmux knows instead
# (user-keys in tmux/tmux.conf), where it clears the pane and its history.
keybind = super+k=csi:99~
