# Font (matches iTerm's Default profile)
font-family = "JetBrains Mono"
font-size = 13

# Transparency
# cmux's default (non-shader) render path ignores background-opacity for the
# terminal pane itself (only the tab bar picks it up). Enabling any custom
# shader — even this no-op passthrough — switches libghostty to a
# post-processing pipeline that preserves alpha, which makes opacity work.
# See: https://github.com/manaflow-ai/cmux/issues/879
background-opacity = 0.85
background-blur-radius = 20
custom-shader = ~/.config/ghostty/passthrough.glsl

# OneDark colors (ported from ~/.dotfiles/iterm2/OneDark.itermcolors)
background = #21252B
foreground = #ABB2BF
cursor-color = #ABB2BF
cursor-text = #21252B
selection-background = #323844
selection-foreground = #ABB2BF

palette = 0=#21252B
palette = 1=#E06C75
palette = 2=#98C379
palette = 3=#E5C07B
palette = 4=#61AFEF
palette = 5=#C678DD
palette = 6=#56B6C2
palette = 7=#ABB2BF
palette = 8=#767676
palette = 9=#E06C75
palette = 10=#98C379
palette = 11=#E5C07B
palette = 12=#61AFEF
palette = 13=#C678DD
palette = 14=#56B6C2
palette = 15=#ABB2BF

# Cursor: blinking underscore.
cursor-style = underline
# Also makes Ghostty ignore DEC mode 12 (the `ESC[?12l` "blink off" that curses
# apps emit via the cnorm capability), which is what keeps the blink alive after
# a full-screen program exits. DECSCUSR from the running program is still honoured.
cursor-style-blink = true

# Ghostty's zsh integration re-emits DECSCUSR on every prompt redraw and keymap
# change — a blinking bar, or a block in vi command mode — and resets to the
# default before each external command, so it overrides cursor-style on every
# keystroke. Turning that one feature off leaves path and title reporting intact.
shell-integration-features = no-cursor
