## Global Settings
## No global ForwardAgent: anyone with root on a host you connect to can use
## a forwarded agent. Enable it per host in config.d/ where it is needed.
#VisualHostKey yes
HashKnownHosts no
#ConnectTimeout 2

Include ~/.orbstack/ssh/config
## Colima prepends an absolute-path Include to ~/.ssh/config, i.e. to this
## tracked file, unless an Include already resolves to its ssh_config.
Include ~/.colima/ssh_config
## Per-host files live in the private overlay (bin/dotfiles). ssh expands `~`
## but not $XDG_CONFIG_HOME, so this is the XDG default spelled out.
Include ~/.config/dotfiles/ssh/*

# See: https://jira.atlassian.com/browse/BSERV-7763
Host bitbucket.org
  ControlMaster no

# Defaults for all SSH connections
Host *
  StrictHostKeyChecking ask
  ControlMaster auto
  ControlPath ~/.ssh/control/%r@%h:%p
  ControlPersist 8h
  KeepAlive yes
  ServerAliveCountMax 6
  ServerAliveInterval 60
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes
