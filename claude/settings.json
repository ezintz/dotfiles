{
  "permissions": {
    "ask": [
      "Bash(make deploy*)",
      "Bash(make apply*)",
      "Bash(make destroy*)",
      "Bash(make release*)",
      "Bash(make publish*)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "hookify@claude-plugins-official": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/tmux/claude-session.sh record",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/tmux/claude-session.sh forget",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "attribution": {
    "commit": "Co-authored by Claude Code 🤖",
    "pr": "Co-authored by Claude Code 🤖",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "theme": "custom:onedark",
  "tui": "fullscreen",
  "env": {
    "CLAUDE_CODE_NATIVE_CURSOR": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
  }
}
