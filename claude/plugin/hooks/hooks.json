{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/hooks/env-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Checking target environment..."
          }
        ]
      }
    ]
  }
}
